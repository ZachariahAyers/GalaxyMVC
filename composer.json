{
    "name": "zachariahayers/galaxymvc",
    "description": "A small PHP MVC framework built from scratch: front controller, reflection-checked router, prepared-statement PDO layer and plain PHP views.",
    "type": "project",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Zachariah Ayers",
            "homepage": "https://ayers.repair"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": "@php database/setup.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
